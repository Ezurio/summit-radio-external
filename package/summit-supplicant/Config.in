menuconfig BR2_PACKAGE_SUMMIT_SUPPLICANT
	bool "Summit Supplicant"
	select BR2_PACKAGE_LIBNL
	select BR2_PACKAGE_OPENSSL
	help
	  Summit Supplicant

if BR2_PACKAGE_SUMMIT_SUPPLICANT

config BR2_PACKAGE_SUMMIT_SUPPLICANT_CLI
	bool "Install wpa_cli binary"
	help
	  Install wpa_cli command line utility

config BR2_PACKAGE_SUMMIT_SUPPLICANT_PASSPHRASE
	bool "Install wpa_passphrase binary"
	help
	  Install wpa_passphrase command line utility.

config BR2_PACKAGE_SUMMIT_SUPPLICANT_WPA_CLIENT_SO
	bool "Install wpa_client shared library"
	depends on !BR2_STATIC_LIBS
	help
	  Install libwpa_client.so.

config BR2_PACKAGE_SUMMIT_SUPPLICANT_DBUS
	bool "Enable support for the DBus control interface"
	depends on BR2_TOOLCHAIN_HAS_THREADS # dbus
	depends on !BR2_PACKAGE_SUMMIT_SUPPLICANT_LEGACY
	select BR2_PACKAGE_DBUS
	default y
	help
	  Enable support for the DBus control interface.

config BR2_PACKAGE_SUMMIT_SUPPLICANT_LEGACY
	bool "Summit Supplicant Legacy"
	select BR2_PACKAGE_SUMMIT_SUPPLICANT_LIBS if (BR2_SUMMIT_WB50N_LEGACY_RADIO || BR2_SUMMIT_WB45N_LEGACY_RADIO) && !BR2_PACKAGE_SUMMIT_SUPPLICANT_LIBS_LOCAL
	select BR2_PACKAGE_SUMMIT_SUPPLICANT_LIBS_LEGACY if (BR2_SUMMIT_WB50N_LEGACY_RADIO || BR2_SUMMIT_WB45N_LEGACY_RADIO) && !BR2_PACKAGE_SUMMIT_SUPPLICANT_LIBS_LOCAL

config BR2_PACKAGE_SUMMIT_SUPPLICANT_FIPS
	bool "Enable FIPS mode"
	help
	  Enables FIPS mode

config BR2_PACKAGE_SUMMIT_SUPPLICANT_DBUS_P2P_ENABLED
	bool "DBUS P2P Interfaces Enabled"
	depends on BR2_PACKAGE_SUMMIT_SUPPLICANT_DBUS
	help
	  If dbus p2p is disabled, installs dbus_overlay.conf with p2p_disabled=1,
	  run-time disabling P2P.

config BR2_PACKAGE_SUMMIT_SUPPLICANT_LIBS_LOCAL
	bool "Internal build of the closed source libraries"
	select BR2_PACKAGE_SUMMIT_SUPPLICANT_LIBS_BUILD

config BR2_PACKAGE_SUMMIT_SUPPLICANT_LIBS_BUILD
	bool
	select BR2_PACKAGE_SDCSDK if BR2_PACKAGE_SUMMIT_SUPPLICANT_LEGACY
	select BR2_PACKAGE_SDCCLI if BR2_PACKAGE_SUMMIT_SUPPLICANT_LEGACY

endif
