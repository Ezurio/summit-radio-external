menuconfig BR2_PACKAGE_SUMMIT_FIRMWARE_NX
	bool "Sona NX61x Radio Firmware"
	select BR2_PACKAGE_WIRELESS_REGDB
	select BR2_PACKAGE_SUMMIT_FIRMWARE_DEVEL if BR2_LRD_DEVEL_BUILD

if BR2_PACKAGE_SUMMIT_FIRMWARE_NX

config BR2_PACKAGE_SUMMIT_FIRMWARE_NX61X
	bool "Sona NX61x SIPT/M.2 1216/M.2 2230 firmware"
	select BR2_PACKAGE_SUMMIT_FIRMWARE_DEVEL_NX61X if BR2_LRD_DEVEL_BUILD
	help
		Sona NX61x firmware package for the SIPT, M.2 1216, and M.2 2230 modules

config BR2_PACKAGE_SUMMIT_FIRMWARE_NX61X_1218
	bool "Sona NX61x M.2 1218 firmware"
	select BR2_PACKAGE_SUMMIT_FIRMWARE_DEVEL_NX61X_1218 if BR2_LRD_DEVEL_BUILD
	help
		Sona NX61x firmware package for the M.2 1218 module with integrated
		chip antenna

choice
	prompt "Sona NX61x Bluetooth interface type"
	default BR2_PACKAGE_SUMMIT_FIRMWARE_NX61X_SERDEV

config BR2_PACKAGE_SUMMIT_FIRMWARE_NX61X_SERDEV
	bool "Sona NX61x Bluetooth serdev support"
	help
		Select this in addition to the appropriate Sona NX61x firmware package
		to enable serdev Bluetooth client support

config BR2_PACKAGE_SUMMIT_FIRMWARE_NX61X_BTATTACH
	bool "Sona NX61x Bluetooth btattach support"
	help
		Select this in addition to the appropriate Sona NX61x firmware package
		to enable btattach Bluetooth client support

endchoice

endif
