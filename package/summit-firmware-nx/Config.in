menuconfig BR2_PACKAGE_SUMMIT_FIRMWARE_NX
	bool "NX Radio Firmware"
	select BR2_PACKAGE_SUMMIT_FIRMWARE_DEVEL if BR2_LRD_DEVEL_BUILD

if BR2_PACKAGE_SUMMIT_FIRMWARE_NX

choice
	prompt "Package Type"

	config BR2_PACKAGE_SUMMIT_FIRMWARE_NX61X
		bool "SIP, 1216, 2230"
		select BR2_PACKAGE_SUMMIT_FIRMWARE_DEVEL_NX61X if BR2_LRD_DEVEL_BUILD
		help
			Sona NX611 SIPT, 1216, and 2230 packages

	config BR2_PACKAGE_SUMMIT_FIRMWARE_NX61X_1218
		bool "1218 with Integrated Antenna"
		select BR2_PACKAGE_SUMMIT_FIRMWARE_DEVEL_NX61X_1218 if BR2_LRD_DEVEL_BUILD
		help
			Sona NX611 1218 package with integrated chip antenna
endchoice 

endif
